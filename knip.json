{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/sdk/index.ts",
    "src/sdk/authoring.ts",
    "src/authoring/scenario.ts",
    "src/sandbox/worker.ts",
    "scripts/*.mjs",
    "server/*.mjs",
    "examples/**/*.{js,ts}"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "server/**/*.mjs"],
  "ignore": ["src/sandbox/virtual.d.ts"],
  "ignoreExportsUsedInFile": false
}
