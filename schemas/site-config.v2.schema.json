{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:open-battle:schema:site-config@2",
  "title": "Open Battle site-config v2",
  "$ref": "#/definitions/SiteConfig",
  "definitions": {
    "SiteConfig": {
      "type": "object",
      "properties": {
        "signal": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nostr": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "turn": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "credential": {
                "type": "string"
              },
              "urls": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "username": {
                "type": "string"
              }
            },
            "required": [
              "urls"
            ]
          }
        },
        "forceTurn": {
          "type": "boolean"
        }
      }
    }
  }
}
