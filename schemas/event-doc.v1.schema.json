{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:open-battle:schema:event-doc@1",
  "title": "Open Battle event-doc v1",
  "$ref": "#/definitions/EventDoc",
  "definitions": {
    "EventDoc": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "event"
        },
        "v": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string"
        },
        "organiser": {
          "$ref": "#/definitions/PlayerKey"
        },
        "name": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "game": {
          "type": "string"
        },
        "points": {
          "type": [
            "number",
            "null"
          ]
        },
        "rounds": {
          "type": "number"
        },
        "start": {
          "type": "number"
        },
        "missions": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "clock": {
          "type": [
            "number",
            "null"
          ]
        },
        "live": {
          "type": "boolean"
        },
        "entrants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Entrant"
          }
        },
        "dropped": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PlayerKey"
          }
        },
        "pairings": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/EventPairing"
            }
          }
        },
        "hand": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HandResult"
          }
        },
        "closed": {
          "type": "boolean"
        },
        "done": {
          "type": "boolean"
        },
        "at": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "v",
        "id",
        "organiser",
        "name",
        "system",
        "game",
        "points",
        "rounds",
        "start",
        "missions",
        "clock",
        "live",
        "entrants",
        "dropped",
        "pairings",
        "hand",
        "closed",
        "done",
        "at"
      ]
    },
    "PlayerKey": {
      "type": "string"
    },
    "Entrant": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/definitions/PlayerKey"
        },
        "name": {
          "type": "string"
        },
        "army": {
          "type": "string"
        },
        "armyName": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "name",
        "army",
        "armyName"
      ]
    },
    "EventPairing": {
      "type": "object",
      "properties": {
        "table": {
          "type": "number"
        },
        "players": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "game": {
          "type": "string"
        }
      },
      "required": [
        "table",
        "players"
      ]
    },
    "HandResult": {
      "type": "object",
      "properties": {
        "round": {
          "type": "number"
        },
        "table": {
          "type": "number"
        },
        "vp": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "round",
        "table",
        "vp"
      ]
    }
  }
}
