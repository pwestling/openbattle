{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:open-battle:schema:campaign@1",
  "title": "Open Battle campaign v1",
  "$ref": "#/definitions/CampaignBook",
  "definitions": {
    "CampaignBook": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "open-battle/campaign@1"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CampaignPlayer"
          }
        },
        "games": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CampaignGame"
          }
        },
        "map": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Territory"
          }
        },
        "units": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/CampaignUnit"
          }
        },
        "notes": {
          "type": "string"
        },
        "event": {
          "$ref": "#/definitions/CampaignEvent"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PackageRef"
          }
        }
      },
      "required": [
        "format",
        "id",
        "name",
        "players",
        "games",
        "map",
        "units",
        "notes"
      ]
    },
    "CampaignPlayer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "armies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "system": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "system"
            ]
          }
        }
      },
      "required": [
        "name",
        "armies"
      ]
    },
    "CampaignGame": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": "number"
        },
        "system": {
          "type": "string"
        },
        "mission": {
          "type": "string"
        },
        "rounds": {
          "type": "number"
        },
        "sides": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CampaignSide"
          }
        },
        "winner": {
          "type": [
            "number",
            "null"
          ]
        },
        "territory": {
          "type": "string"
        },
        "byHand": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "at",
        "system",
        "rounds",
        "sides",
        "winner"
      ]
    },
    "CampaignSide": {
      "type": "object",
      "properties": {
        "players": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "armies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vp": {
          "type": "number"
        },
        "slain": {
          "type": "number"
        },
        "lost": {
          "type": "number"
        }
      },
      "required": [
        "players",
        "armies",
        "vp",
        "slain",
        "lost"
      ]
    },
    "Territory": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "holder": {
          "type": "string"
        },
        "table": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "CampaignUnit": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "army": {
          "type": "string"
        },
        "kills": {
          "type": "number"
        },
        "games": {
          "type": "number"
        },
        "survived": {
          "type": "number"
        },
        "wounds": {
          "type": "number"
        },
        "honours": {
          "type": "string"
        },
        "scars": {
          "type": "string"
        },
        "xp": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "army",
        "kills",
        "games",
        "survived",
        "wounds",
        "honours",
        "scars"
      ]
    },
    "CampaignEvent": {
      "type": "object",
      "properties": {
        "rounds": {
          "type": "number"
        },
        "entrants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dropped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "pairings": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/EventPairing"
            }
          }
        },
        "dropLog": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "out": {
                "type": "boolean"
              },
              "at": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "out",
              "at"
            ]
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "rounds",
        "entrants",
        "dropped",
        "tables",
        "pairings"
      ]
    },
    "EventPairing": {
      "type": "object",
      "properties": {
        "table": {
          "type": "number"
        },
        "players": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "game": {
          "type": "string"
        }
      },
      "required": [
        "table",
        "players"
      ]
    },
    "PackageRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "bytes": {
          "type": "number"
        },
        "kind": {
          "type": "string",
          "const": "system"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "hash",
        "bytes"
      ]
    }
  }
}
