{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:open-battle:schema:side-message@2",
  "title": "Open Battle side-message v2",
  "$ref": "#/definitions/SideMessage",
  "definitions": {
    "SideMessage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "package/want"
            },
            "hash": {
              "type": "string"
            }
          },
          "required": [
            "t",
            "hash"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "package/part"
            },
            "hash": {
              "type": "string"
            },
            "part": {
              "type": "number"
            },
            "parts": {
              "type": "number"
            },
            "data": {
              "type": "string"
            }
          },
          "required": [
            "t",
            "hash",
            "part",
            "parts",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "package/status"
            },
            "missing": {
              "type": "array",
