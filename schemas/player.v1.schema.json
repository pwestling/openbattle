{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:open-battle:schema:player@1",
  "title": "Open Battle player v1",
  "$ref": "#/definitions/PlayerFile",
  "definitions": {
    "PlayerFile": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "open-battle/player@1"
        },
        "card": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "colors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "name",
            "colors"
          ]
        },
        "identity": {
          "$ref": "#/definitions/Identity"
        }
      },
      "required": [
        "format",
        "card",
        "identity"
      ]
    },
    "Identity": {
