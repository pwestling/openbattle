{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:open-battle:schema:entry-doc@1",
  "title": "Open Battle entry-doc v1",
  "$ref": "#/definitions/EntryDoc",
  "definitions": {
    "EntryDoc": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "entry"
        },
        "v": {
          "type": "number",
          "const": 1
        },
        "event": {
          "type": "string"
        },
        "key": {
          "$ref": "#/definitions/PlayerKey"
        },
        "name": {
          "type": "string"
        },
        "army": {
          "type": "string"
        },
        "armyName": {
          "type": "string"
        },
        "out": {
          "type": "boolean"
        },
        "at": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "v",
        "event",
        "key",
        "name",
        "army",
        "armyName",
        "at"
      ]
    },
    "PlayerKey": {
      "type": "string"
    }
  }
}
