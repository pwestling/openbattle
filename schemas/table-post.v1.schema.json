{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:open-battle:schema:table-post@1",
  "title": "Open Battle table-post v1",
  "$ref": "#/definitions/TablePost",
  "definitions": {
    "TablePost": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "game": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "start": {
          "type": [
            "number",
            "null"
          ]
        },
        "lang": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/TableKind"
        },
        "voice": {
          "type": "boolean"
        },
        "seats": {
          "type": "number"
        },
        "note": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TableTag"
          }
        },
        "join": {
          "type": "string"
        },
        "watch": {
          "type": "boolean"
        },
        "live": {
          "$ref": "#/definitions/LiveInfo"
        },
        "ranked": {
          "type": "boolean"
        },
        "player": {
          "$ref": "#/definitions/PlayerKey"
        },
        "proof": {
          "type": "string"
        },
        "event": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "round": {
              "type": "number"
            },
            "table": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "name",
            "round",
            "table"
          ]
        },
        "expires": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "system",
        "game",
        "size",
        "start",
        "lang",
        "kind",
        "voice",
        "seats",
        "note",
        "join",
        "expires"
      ]
    },
    "TableKind": {
      "type": "string",
      "enum": [
        "live",
        "mail"
      ]
    },
    "TableTag": {
      "type": "string",
      "enum": [
        "new",
        "relaxed",
        "competitive",
        "narrative"
      ]
    },
    "LiveInfo": {
      "type": "object",
      "properties": {
        "round": {
          "type": "number"
        },
        "rounds": {
          "type": "number"
        },
        "score": {
          "type": "string"
        },
        "watching": {
          "type": "number"
        },
        "sides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "since": {
          "type": "number"
        },
        "computer": {
          "type": "boolean"
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PlayerKey"
          }
        }
      },
      "required": [
        "round",
        "rounds",
        "score",
        "watching"
      ]
    },
    "PlayerKey": {
      "type": "string"
    }
  }
}
