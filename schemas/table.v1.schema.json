{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:open-battle:schema:table@1",
  "title": "Open Battle table v1",
  "$ref": "#/definitions/TableFile",
  "definitions": {
    "TableFile": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "open-battle/table@1"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "savedAt": {
          "type": "number"
        },
        "table": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number"
            },
            "depth": {
              "type": "number"
            }
          },
          "required": [
            "width",
            "depth"
          ]
        },
        "layout": {
          "$ref": "#/definitions/Layout"
        },
        "attachments": {
          "type": "object",
          "properties": {
            "assets": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "format",
        "id",
        "layout",
        "name",
        "savedAt",
        "system",
        "table"
      ]
    },
    "Layout": {
      "type": "object",
      "properties": {
        "terrain": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TerrainPiece"
          }
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Objective"
          }
        },
        "zones": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Zone"
          }
        },
        "decks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CardDeck"
          }
        }
      },
      "required": [
        "terrain",
        "objectives",
        "zones"
      ]
    },
    "TerrainPiece": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "$ref": "#/definitions/TerrainCategory"
        },
        "position": {
          "$ref": "#/definitions/Vec2"
        },
        "width": {
          "type": "number"
        },
        "depth": {
          "type": "number"
        },
        "facing": {
          "type": "number"
        },
        "solids": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TerrainSolid"
          }
        },
        "losHeight": {
          "type": "number"
        },
        "sight": {
          "type": "string",
          "enum": [
            "true",
            "heights"
          ]
        },
        "visibility": {
          "type": "string",
          "enum": [
            "open",
            "obscuring",
            "blocking"
          ]
        },
        "hull": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "mesh": {
          "type": "object",
          "properties": {
            "asset": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "scale": {
              "type": "number"
            }
          },
          "required": [
            "asset",
            "name",
            "scale"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "position",
        "width",
        "depth",
        "facing",
        "solids"
      ]
    },
    "TerrainCategory": {
      "type": "string"
    },
    "Vec2": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "TerrainSolid": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "wall",
            "floor",
            "block",
            "foliage"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "d": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "x",
        "y",
        "z",
        "w",
        "d",
        "h"
      ]
    },
    "Objective": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "position": {
          "$ref": "#/definitions/Vec2"
        },
        "label": {
          "type": "string"
        },
        "look": {
          "type": "string",
          "enum": [
            "marker",
            "lantern"
          ]
        }
      },
      "required": [
        "id",
        "position"
      ]
    },
    "Zone": {
      "type": "object",
      "properties": {
        "seat": {
          "type": "number"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Vec2"
          }
        }
      },
      "required": [
        "seat",
        "points"
      ]
    },
    "CardDeck": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Card"
          }
        }
      },
      "required": [
        "id",
        "name",
        "cards"
      ]
    },
    "Card": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "face": {
          "$ref": "#/definitions/CardFace"
        },
        "back": {
          "$ref": "#/definitions/CardFace"
        },
        "sideways": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "face"
      ]
    },
    "CardFace": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "cols": {
          "type": "number"
        },
        "rows": {
          "type": "number"
        },
        "index": {
          "type": "number"
        }
      },
      "required": [
        "url",
        "cols",
        "rows",
        "index"
      ]
    }
  }
}
