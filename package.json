{
  "name": "open-battle",
  "version": "0.1.0",
  "private": true,
  "description": "Open source, peer-to-peer, browser-based tabletop for miniatures wargames.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "relay": "node server/relay.mjs",
    "schemas": "node scripts/schemas.mjs",
    "schemas:check": "node scripts/schemas.mjs --check",
    "package:build": "node scripts/package-build.mjs",
    "package:scenario": "node scripts/package-scenario.mjs",
    "deadcode": "knip"
  },
  "dependencies": {
    "@trystero-p2p/nostr": "^0.26.0",
    "@trystero-p2p/ws-relay": "0.26.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "knip": "^5.88.1",
    "prettier": "^3.9.9",
    "ts-json-schema-generator": "2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  }
}
